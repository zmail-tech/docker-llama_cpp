version = {version}

[*]
flash-attn = {global_flash_attn}
n-gpu-layers = {n_gpu_layers}
c = {context_size}
t = {temperature}
b = {batch_size}
ub = {ubatch_size}

; {model_name}
[{model_name}]
m = {model_path}
{mmproj = {mmproj_path}}
ctx-size = {ctx_size}
temp = {temp}
top-p = {top_p}
top-k = {top_k}
min-p = {min_p}
n-predict = {n_predict}
ngl = {ngl}
flash-attn = {flash_attn}
cache-type-k = {cache_type_k}
cache-type-v = {cache_type_v}
chat-template-kwargs = {chat_template_kwargs}
{jinja = {jinja}}

;[Gemma-4-12B-Reasoning]
;m = /models/gemma/4/12b/qat/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
;mmproj = /models/gemma/4/12b/qat/mmproj-BF16.gguf
;ctx-size = 32768
;batch-size = 2048
;ubatch-size = 512
;temp = 1.0
;top-p = 0.95
;top-k = 64
;jinja = enabled
;ngl = 999
;fit = off
;flash-attn = auto
;cache-type-k = q4_0
;cache-type-v = q4_0
;chat-template-kwargs = {"enable_thinking": true}

; Settings for speculative decoding
;;md = /models/gemma/4/12b/qat/gemma-4-12B-it-qat-assistant-MTP-Q8_0.gguf
;;ngld = 999
;;spec-type = draft-mtp
;;spec-draft-n-max = 3
;;spec-draft-type-k = q8_0
;;spec-draft-type-v = q8_0
